<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.*,com.cropknowledge.model.Crop,com.cropknowledge.web.Html" %>
<% String root=request.getContextPath(); List<Crop> crops=(List<Crop>)request.getAttribute("crops"); String status=request.getParameter("status"); %>
<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>管理员后台 · 作物资料</title><link rel="stylesheet" href="<%=root%>/assets/site.css"><link rel="stylesheet" href="<%=root%>/assets/admin.css"></head><body>
<header class="site-header"><a class="brand" href="<%=root%>/">作物知识库</a><nav><a href="<%=root%>/search">查询</a><a href="<%=root%>/assistant">DeepSeek 问答</a><a href="<%=root%>/account/">账户</a><form action="<%=root%>/logout" method="post"><button class="link-button" type="submit">退出</button></form></nav></header>
<main class="page admin-page"><div class="intro"><span class="eyebrow">ADMINISTRATION</span><h1>资料维护</h1><p>管理作物资料、审核状态、样品检测数据和图片。</p></div>
<section class="admin-toolbar"><form method="get" action="<%=root%>/admin/crops"><input name="name" value="<%=Html.escape(request.getParameter("name"))%>" placeholder="按作物名称搜索"><select name="status"><option value="ALL">全部状态</option><% for(String option:new String[]{"DRAFT","PENDING","APPROVED","REJECTED"}){ %><option value="<%=option%>" <%=option.equals(status)?"selected":""%>><%=option%></option><% } %></select><button class="button small" type="submit">筛选</button></form><a class="button" href="<%=root%>/admin/crops/edit">新增作物</a><a class="button" href="<%=root%>/admin/ai-suggest">DeepSeek OCR 建议</a></section>
<% if(crops==null||crops.isEmpty()){ %><div class="empty-state">没有符合条件的资料。</div><% }else{ %><div class="table-scroll"><table class="admin-table"><thead><tr><th>作物</th><th>学名</th><th>科属</th><th>状态</th><th>来源页</th><th></th></tr></thead><tbody><% for(Crop crop:crops){ %><tr><td><strong><%=Html.escape(crop.chineseName)%></strong></td><td><%=Html.escape(crop.latinName)%></td><td><%=Html.escape(crop.family)%> / <%=Html.escape(crop.genus)%></td><td><span class="status status-<%=Html.escape(crop.reviewStatus)%>"><%=Html.escape(crop.reviewStatus)%></span></td><td><%=crop.sourcePage==0?"—":crop.sourcePage%></td><td><a href="<%=root%>/admin/crops/edit?id=<%=crop.id%>">编辑</a></td></tr><% } %></tbody></table></div><% } %>
</main></body></html>
